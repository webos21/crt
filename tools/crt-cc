#!/bin/sh
set -eu

if [ -z "${CRT_SYSROOT:-}" ]; then
  echo "crt-cc: CRT_SYSROOT is not set" >&2
  exit 1
fi

target_os="${CRT_TARGET_OS:-}"
if [ -z "$target_os" ]; then
  case "$(uname -s)" in
    Darwin) target_os=macos ;;
    Linux) target_os=linux ;;
    MINGW*|MSYS*|CYGWIN*) target_os=windows ;;
    *) target_os=unknown ;;
  esac
fi

cc="${CRT_HOST_CC:-clang}"
if [ "$target_os" = windows ]; then
  export CRT_SPAWN_NATIVE_WINDOWS=1
  target_arch="${CRT_TARGET_ARCH:-}"
  if [ -z "$target_arch" ]; then
    # Check both `uname -m` (the semantically correct field, and what this
    # project's own toybox `uname` reports -- it prints `uname -s` as the
    # bare "Windows", no ARM64 suffix) and `uname -s` (MSYS/Git-Bash's own
    # `uname`, which instead puts the arch on the end of -s, e.g.
    # "MINGW64_NT-10.0-26200-ARM64", and reports "x86_64" from -m even on
    # an ARM64 host under x86_64 emulation) together, so this works
    # whichever `uname` ends up on PATH when this script runs.
    case "$(uname -m 2>/dev/null)$(uname -s 2>/dev/null)" in
      *aarch64*|*arm64*|*ARM64*) target_arch=aarch64 ;;
      *) target_arch=x86_64 ;;
    esac
  fi
fi
set +e
resource_dir="$("$cc" -print-resource-dir 2>/dev/null)"
set -e

windows_host_arg() {
  case "$1" in
    /*)
      if [ -n "${CRT_ROOTFS:-}" ]; then
        rootfs=$(printf '%s\n' "$CRT_ROOTFS" | sed 's|\\|/|g')
        printf '%s/%s\n' "$rootfs" "${1#/}"
      else
        printf '%s\n' "$1"
      fi
      ;;
    -I/*|-L/*)
      prefix=${1%%/*}
      path=/${1#*/}
      if [ -n "${CRT_ROOTFS:-}" ]; then
        rootfs=$(printf '%s\n' "$CRT_ROOTFS" | sed 's|\\|/|g')
        printf '%s%s/%s\n' "$prefix" "$rootfs" "${path#/}"
      else
        printf '%s\n' "$1"
      fi
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

user_args=""
for arg in "$@"; do
  if [ "$target_os" = windows ]; then
    arg=$(windows_host_arg "$arg")
  fi
  user_args="$user_args $(printf '%s\n' "$arg")"
done

compile_only=0
shared_mode=0
relocatable_mode=0
for arg in "$@"; do
  case "$arg" in
    -c|-E|-S) compile_only=1 ;;
    -shared|-dynamiclib) shared_mode=1 ;;
    -r|-Wl,-r) relocatable_mode=1 ;;
  esac
done

common_flags="-ffreestanding -fno-builtin -Xclang -fwchar-type=int -ffunction-sections -fdata-sections -nostdinc -isystem${CRT_SYSROOT}/include"
case "$target_os" in
  macos) common_flags="$common_flags -DCRT_TARGET_OS_MACOS=1" ;;
  linux) common_flags="$common_flags -DCRT_TARGET_OS_LINUX=1" ;;
  windows)
    common_flags="$common_flags -DCRT_TARGET_OS_WINDOWS=1"
    # A stock Windows LLVM install's clang.exe defaults to its own host
    # triple, *-pc-windows-msvc, when no --target is given. That MSVC-
    # compatible predefined-macro set doesn't define __GNUC__ (only
    # _MSC_VER, mimicking real MSVC) -- which is harmless to this
    # project's own freestanding CRT/PAL builds (none of our own headers
    # branch on __GNUC__), but silently misleads every third-party
    # autoconf/libtool port: their `configure` scripts' near-universal
    # "checking whether the compiler supports GNU C" probe (and libtool's
    # own internal with_gnu_ld override for `case $host_os in
    # cygwin*|mingw*...)`, which hardcodes `with_gnu_ld=no` unless
    # `$GCC = yes`) both concluded "no", sending libtool down its
    # MSVC-native `lib -OUT:...` archiving path -- which this project has
    # no `lib.exe` for -- well past the actual GNU-ld-detection fix
    # already applied above. Explicitly targeting *-w64-mingw32 makes
    # clang emit the GNU-compatible macro set (__GNUC__, __MINGW32__)
    # that these `configure`-generated probes -- and this project's own
    # `--build=aarch64-w64-mingw32` autoconf host-triple workaround (see
    # porting/recipes/*.json) -- already expect. Verified this doesn't
    # change anything for our own build: we pass -nostdinc/-nostdlib and
    # our own -isystem/-L paths throughout, so the target triple only
    # affects predefined macros and calling-convention details, not which
    # headers/libs get used.
    common_flags="$common_flags --target=${target_arch}-w64-mingw32"
    # clang predefines __MINGW32__ for this target but, unlike a real
    # mingw-w64 install's own _mingw.h, does NOT predefine
    # __MINGW32_MAJOR_VERSION/__MINGW32_MINOR_VERSION (the legacy
    # mingw.org-era compat version pair real mingw-w64 headers still
    # define for backward compatibility). Third-party sources that probe
    # those macros to distinguish "ancient mingw.org, pre-3.0" from "any
    # real mingw-w64" (ISO C preprocessor arithmetic treats an undefined
    # macro as 0, so `__MINGW32_MAJOR_VERSION < 3` silently evaluates
    # true) end up on the ancient-compat branch instead -- hit for real in
    # GNU make's src/dir.c, whose `#if __MINGW32_MAJOR_VERSION < 3 ...`
    # guards an old-mingw-only `d->d_name = xmalloc(...)` assignment that
    # doesn't compile against this project's Bionic-style `struct dirent`
    # (`d_name` is a fixed array, not a pointer). Arch-independent (same
    # bug on both aarch64-w64-mingw32 and x86_64-w64-mingw32) and Windows-
    # only (macOS/Linux never define __MINGW32__ at all). Defining these
    # to match a real, current mingw-w64 install's actual values -- not
    # picking arbitrary "big enough" numbers -- keeps every third-party
    # mingw-version probe seeing the same, real answer a genuine mingw-w64
    # toolchain would give.
    common_flags="$common_flags -D__MINGW32_MAJOR_VERSION=3 -D__MINGW32_MINOR_VERSION=11"
    ;;
esac

# resource_dir (clang's own -print-resource-dir, which houses compiler-
# provided architecture-intrinsic headers like arm_neon.h/immintrin.h --
# separate from anything in CRT_SYSROOT) is passed as its own quoted
# "-isystem" "$resource_dir/include" argument pair directly on each exec
# line below, NOT folded into $common_flags: common_flags/user_args/libs
# are all plain, unquoted-expanded strings throughout this script (relying
# on word-splitting to turn them back into separate argv entries), which
# silently breaks apart any single value that itself contains a space --
# and a stock Windows LLVM install's resource-dir is almost always under
# "C:\Program Files\...". Quoting just this one pair sidesteps that
# without a wider rewrite of how this script builds argument lists.
if [ "$compile_only" -eq 1 ]; then
  if [ -n "$resource_dir" ]; then
    # shellcheck disable=SC2086
    exec "$cc" $common_flags -isystem "${resource_dir}/include" $user_args
  fi
  # shellcheck disable=SC2086
  exec "$cc" $common_flags $user_args
fi

# A relocatable link (`ld -r`, usually seen through libtool as
# `crt-cc -Wl,-r -o partial.o ...`) is neither an executable nor a shared
# library. Do not add crt1.o, entry-point flags, section-gc/dead-strip flags,
# or CRT libraries here; the output is an intermediate object that will be
# linked for real later. This matters on macOS where ld64 rejects `-r` together
# with `-dead_strip`, and it is the right model for ELF/COFF too.
if [ "$relocatable_mode" -eq 1 ]; then
  if [ "$target_os" = macos ]; then
    user_args="$user_args -Wl,-keep_private_externs"
  fi
  if [ -n "$resource_dir" ]; then
    # shellcheck disable=SC2086
    exec "$cc" $common_flags -isystem "${resource_dir}/include" $user_args
  fi
  # shellcheck disable=SC2086
  exec "$cc" $common_flags $user_args
fi

# -shared/-dynamiclib (shared_mode, detected above alongside -c/-E/-S):
# builds a .dll/.so/.dylib instead of an executable. A shared object has
# no argv/envp entry point the way an EXE's _start/mainCRTStartup does --
# the OS loader calls into it very differently (DllMain on Windows,
# .init_array on Linux, nothing at all needed on macOS/dyld) -- so
# crt1.o/the EXE entry-point flags below are specific to executables and
# do not apply here. Windows additionally needs its own small DLL entry
# stub (dllcrt.o, crtDllMainCRTStartup -- see libc/src/arch/windows/
# common/dllcrt.c) in place of crt1.o, and the linker's own /DLL flag to
# actually emit a DLL-flavored PE image instead of an EXE-flavored one.
if [ "$shared_mode" -eq 1 ]; then
  libs="-L${CRT_SYSROOT}/lib"
else
  libs="${CRT_SYSROOT}/lib/crt1.o -L${CRT_SYSROOT}/lib"
fi
# prelibs: objects that must land on the link line *before* $user_args
# (the program's own object files, and any third-party static library it
# links against, e.g. a port's own .a) rather than after -- currently
# only Windows' .ctors/.dtors "begin" sentinel needs this (see
# libc/src/arch/windows/common/ctors_begin.c's own comment for why it
# must be the very first .ctors/.dtors contributor on the whole link
# line). Empty everywhere else.
prelibs=""
# macOS/Linux crt_libs (below): the static archives (libc.a/libm.a/
# libdl.a/libc++.a) are only safe to link into an EXECUTABLE. They were
# never compiled with -fPIC (nothing about a normal, non-PIE-shared
# executable requires it), so linking them directly into a `-shared`/
# `-dynamiclib` output can fail outright on a strict ELF linker: hit for
# real building zlib's shared library on Linux aarch64 -- `ld` refused
# libc.a(stdio.c.o)'s R_AARCH64_ADR_PREL_PG_HI21 relocations against
# `stdin`/`stdout`/`stderr` ("dangerous relocation: unsupported
# relocation ... recompile with -fPIC") the moment a shared-library probe
# needed a stdio.c.o symbol (getchar()). This didn't surface on macOS
# because Mach-O/AArch64 code is unconditionally position-independent at
# the ABI level regardless of -fPIC, so the same non-PIC libc.a objects
# link into a macOS .dylib without complaint -- macOS was never actually
# safe either, just not strictly checked the way Linux's ld checks it.
# The fix on both: for shared_mode, link the already-built *shared*
# counterparts (libc.so/libm.so/libdl.so/libc++.so, or their .dylib
# equivalents on macOS -- both already built into the sysroot by this
# project's own CMake c_shared/m_shared/dl_shared/cxx_shared targets)
# instead of the static archives, exactly like a real shared library is
# normally expected to link against a shared libc rather than statically
# embedding one. libclang_rt.builtins.a is deliberately left static in
# both modes: it's leaf compiler-intrinsic code with no global-data
# relocations of this kind, and statically linking compiler-rt/libgcc
# into every shared object (not just executables) is itself completely
# normal, standard practice.
case "$target_os" in
  macos)
    if [ "$shared_mode" -eq 1 ]; then
      libs="$libs ${CRT_SYSROOT}/lib/libc.dylib ${CRT_SYSROOT}/lib/libm.dylib ${CRT_SYSROOT}/lib/libdl.dylib ${CRT_SYSROOT}/lib/libc++.dylib ${CRT_SYSROOT}/lib/libclang_rt.builtins.a -lSystem"
      entry="-Wl,-dead_strip -Wl,-rpath,${CRT_SYSROOT}/lib"
    else
      libs="$libs ${CRT_SYSROOT}/lib/libc.a ${CRT_SYSROOT}/lib/libm.a ${CRT_SYSROOT}/lib/libdl.a ${CRT_SYSROOT}/lib/libc++.a ${CRT_SYSROOT}/lib/libclang_rt.builtins.a -lSystem"
      entry="-Wl,-e,_start -Wl,-dead_strip"
    fi
    ;;
  linux)
    if [ "$shared_mode" -eq 1 ]; then
      crt_libs="${CRT_SYSROOT}/lib/libc.so ${CRT_SYSROOT}/lib/libm.so ${CRT_SYSROOT}/lib/libdl.so ${CRT_SYSROOT}/lib/libc++.so"
    else
      crt_libs="${CRT_SYSROOT}/lib/libc.a ${CRT_SYSROOT}/lib/libm.a ${CRT_SYSROOT}/lib/libdl.a ${CRT_SYSROOT}/lib/libc++.a"
      # __crt_run_init_array()/__crt_run_fini_array() (see
      # libc/src/arch/linux/common/init_fini_array.c): must be linked
      # directly into every executable, alongside crt1.o itself, so its
      # __init_array_start/__init_array_end boundary symbols always
      # reflect the calling executable's own link -- not some other
      # DSO's -- regardless of whether libc itself ends up static or
      # shared here. A -shared/.so build has no equivalent need (a
      # shared object's own .init_array is handled by the OS's dynamic
      # loader when it's loaded, not by this project's own startup
      # code), matching why crt1.o itself is skipped in that case too.
      libs="$libs ${CRT_SYSROOT}/lib/crt1_init_array.o"
    fi
    libs="$libs $crt_libs ${CRT_SYSROOT}/lib/libclang_rt.builtins.a"
    if [ "$shared_mode" -eq 1 ]; then
      # None of libc.so/libm.so/libdl.so/libc++.so set an explicit
      # -soname (nothing in this build sets one), so each defaults to
      # its own bare output filename ("libc.so", ...) as its own
      # DT_SONAME -- and that's exactly the literal string this shared
      # object then records as its DT_NEEDED entry when it links against
      # them by path. At runtime the dynamic loader has no memory of the
      # absolute path used at link time; it re-searches for that bare
      # name via the standard system search path (ld.so.cache, default
      # library dirs), which can genuinely find something else entirely
      # by the same name -- hit for real on Ubuntu/Debian aarch64, where
      # /lib/aarch64-linux-gnu/libc.so exists as part of libc6-dev: a
      # plain-text GNU-ld INPUT() linker script meant only for the
      # *host* toolchain's own link-time use, not a real loadable ELF
      # image, so ld.so rejected it outright ("invalid ELF header").
      # -rpath bakes this project's own sysroot lib dir into this
      # object's DT_RUNPATH, which the loader consults (before the
      # system default path) specifically when resolving *this object's
      # own* DT_NEEDED entries -- so it finds this project's real
      # libc.so there first, regardless of what unrelated file of the
      # same bare name the host system happens to have on its own
      # standard search path.
      entry="-Wl,--gc-sections -Wl,-rpath,${CRT_SYSROOT}/lib"
    else
      entry="-Wl,-e,_start -Wl,--gc-sections"
    fi
    ;;
  windows)
    if [ -n "${CRT_WINDOWS_SDK_LIBPATH:-}" ]; then
      libs="$libs -Wl,/libpath:${CRT_WINDOWS_SDK_LIBPATH}"
    fi
    libs="$libs ${CRT_SYSROOT}/lib/c.lib ${CRT_SYSROOT}/lib/m.lib ${CRT_SYSROOT}/lib/dl.lib ${CRT_SYSROOT}/lib/c++.lib ${CRT_WINDOWS_SYSTEM_LIBS:--Wl,kernel32.lib -Wl,synchronization.lib}"
    if [ "$shared_mode" -eq 1 ]; then
      libs="${CRT_SYSROOT}/lib/dllcrt.o $libs"
      entry="-Wl,/entry:crtDllMainCRTStartup -Wl,/DLL -Wl,/OPT:REF -fuse-ld=lld"
    else
      entry="-Wl,/entry:mainCRTStartup -Wl,/subsystem:console -Wl,/OPT:REF -fuse-ld=lld"
      # __crt_run_init_array()/__crt_run_fini_array() Windows/PE support
      # (see libc/src/arch/windows/common/init_fini_array.c's own
      # comment): ctors_begin.o must be the first .ctors/.dtors
      # contributor on the whole link line (here, via $prelibs, ahead of
      # $user_args below) and ctors_end.o must be the last (appended to
      # the very end of $libs, after even the Windows system libs) --
      # same reasoning as Linux's crt1_init_array.o, but split across two
      # position-sensitive sentinel objects instead of one, since COFF/PE
      # has no ELF-style automatic section-boundary symbols. A
      # -shared/DLL build has no equivalent need (a DLL's own .ctors is
      # handled by the OS loader when it loads, not by this project's own
      # startup code), matching why crt1.o itself is skipped there too.
      # crt1_pseudo_reloc.o (_pei386_runtime_relocator(), see that file's
      # own comment) isn't position-sensitive -- it just needs to exist
      # somewhere in the link, and is called from crt1.c's own startup
      # code -- but rides along in $prelibs with the other walker object
      # purely for convenience.
      prelibs="${CRT_SYSROOT}/lib/crt1_ctors_begin.o ${CRT_SYSROOT}/lib/crt1_ctors_walker.o ${CRT_SYSROOT}/lib/crt1_pseudo_reloc.o"
      libs="$libs ${CRT_SYSROOT}/lib/crt1_ctors_end.o"
    fi
    ;;
  *)
    echo "crt-cc: unsupported CRT_TARGET_OS=$target_os" >&2
    exit 1
    ;;
esac

if [ -n "$resource_dir" ]; then
  # shellcheck disable=SC2086
  exec "$cc" $common_flags -isystem "${resource_dir}/include" -nostdlib -nostartfiles -nodefaultlibs $entry $prelibs $user_args $libs
fi
# shellcheck disable=SC2086
exec "$cc" $common_flags -nostdlib -nostartfiles -nodefaultlibs $entry $prelibs $user_args $libs
