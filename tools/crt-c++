#!/bin/sh
set -eu

if [ -z "${CRT_SYSROOT:-}" ]; then
  echo "crt-c++: CRT_SYSROOT is not set" >&2
  exit 1
fi

target_os="${CRT_TARGET_OS:-}"
if [ -z "$target_os" ]; then
  case "$(uname -s)" in
    Darwin) target_os=macos ;;
    Linux) target_os=linux ;;
    MINGW*|MSYS*|CYGWIN*) target_os=windows ;;
    *) target_os=unknown ;;
  esac
fi

cxx="${CRT_HOST_CXX:-clang++}"
compiler_rt_builtins=""
if [ "$target_os" = windows ]; then
  export CRT_SPAWN_NATIVE_WINDOWS=1
  target_arch="${CRT_TARGET_ARCH:-}"
  if [ -z "$target_arch" ]; then
    # See the matching comment in tools/crt-cc: check both `uname -m` and
    # `uname -s` together so this works under either this project's own
    # toybox `uname` or a host MSYS/Git-Bash `uname`.
    case "$(uname -m 2>/dev/null)$(uname -s 2>/dev/null)" in
      *aarch64*|*arm64*|*ARM64*) target_arch=aarch64 ;;
      *) target_arch=x86_64 ;;
    esac
  fi
fi
set +e
resource_dir="$("$cxx" -print-resource-dir 2>/dev/null)"
set -e

windows_host_arg() {
  case "$1" in
    /*)
      if [ -n "${CRT_ROOTFS:-}" ]; then
        rootfs=$(printf '%s\n' "$CRT_ROOTFS" | sed 's|\\|/|g')
        printf '%s/%s\n' "$rootfs" "${1#/}"
      else
        printf '%s\n' "$1"
      fi
      ;;
    -I/*|-L/*)
      prefix=${1%%/*}
      path=/${1#*/}
      if [ -n "${CRT_ROOTFS:-}" ]; then
        rootfs=$(printf '%s\n' "$CRT_ROOTFS" | sed 's|\\|/|g')
        printf '%s%s/%s\n' "$prefix" "$rootfs" "${path#/}"
      else
        printf '%s\n' "$1"
      fi
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

user_args=""
for arg in "$@"; do
  if [ "$target_os" = windows ]; then
    arg=$(windows_host_arg "$arg")
  fi
  case "$arg" in
    -lpthread|-lrt)
      # Bionic merged these historical libraries into libc. Let the CRT libc
      # selected below satisfy their symbols instead of leaking a host
      # libpthread/librt into standalone Android runtime builds.
      ;;
    -lc)
      # While producing libc++/libc++abi themselves, the wrapper below picks
      # the correct static/shared CRT libc shape. Keeping the standalone
      # project's extra -lc would select a second or host-shaped libc.
      if [ "${CRT_CXX_BUILDING_RUNTIME:-0}" != 1 ]; then
        user_args="$user_args $(printf '%s\n' "$arg")"
      fi
      ;;
    *) user_args="$user_args $(printf '%s\n' "$arg")" ;;
  esac
done

compile_only=0
shared_mode=0
runtime_linkage="${CRT_CXX_RUNTIME_LINKAGE:-static}"
case "$runtime_linkage" in
  static|shared) ;;
  *)
    echo "crt-c++: CRT_CXX_RUNTIME_LINKAGE must be static or shared" >&2
    exit 1
    ;;
esac
for arg in "$@"; do
  case "$arg" in
    -c|-E|-S) compile_only=1 ;;
    -shared|-dynamiclib) shared_mode=1 ;;
  esac
done

# C++ standard library headers must come before the CRT C headers. libc++'s
# wrappers such as <cstddef> intentionally include their own <stddef.h> first
# and then forward to the C header underneath.
cxx_standard_include_flags="${CRT_CXX_STANDARD_INCLUDE_FLAGS:-}"
cxx_language_flags=""
if [ "${CRT_CXX_ENABLE_EXCEPTIONS:-0}" != "1" ]; then
  cxx_language_flags="$cxx_language_flags -fno-exceptions"
fi
if [ "${CRT_CXX_ENABLE_RTTI:-0}" != "1" ]; then
  cxx_language_flags="$cxx_language_flags -fno-rtti"
fi
common_flags="-ffreestanding -fno-builtin -Xclang -fwchar-type=int -ffunction-sections -fdata-sections$cxx_language_flags -nostdinc -nostdinc++ $cxx_standard_include_flags -isystem${CRT_SYSROOT}/include"
case "$target_os" in
  macos) common_flags="$common_flags -DCRT_TARGET_OS_MACOS=1 -U__APPLE__" ;;
  linux) common_flags="$common_flags -DCRT_TARGET_OS_LINUX=1" ;;
  windows)
    # See the matching comment in tools/crt-cc: without an explicit
    # --target, a stock Windows LLVM install's clang++.exe defaults to
    # *-pc-windows-msvc, whose predefined macros (_MSC_VER, no __GNUC__)
    # mislead third-party autoconf/libtool ports into picking the wrong,
    # MSVC-native build path. *-w64-mingw32 matches what those ports'
    # `configure` scripts (and this project's own --build=*-w64-mingw32
    # recipe workarounds) already expect.
    common_flags="$common_flags -DCRT_TARGET_OS_WINDOWS=1 -fno-threadsafe-statics --target=${target_arch}-w64-mingw32"
    # See docs/cxx_runtime.md's "Windows exception-table format: DWARF
    # CFI, not native SEH" for the full architectural reasoning (this
    # project's own from-source libunwind/libc++abi are built as portable
    # DWARF-CFI unwinders, not linked against native SEH). That decision
    # has to apply to every Windows C++ translation unit compiled through
    # this wrapper, not only the recipe.json-driven build of libcxx/
    # libcxxabi/libunwind themselves: Clang's default exception model for
    # *-w64-mingw32 is native SEH (__gxx_personality_seh0), which this
    # project's own libc++abi.a was never built to provide (it exports
    # __gxx_personality_v0, the DWARF/Itanium personality, instead).
    # Confirmed for real: the first real Windows C++ *client* program
    # ever linked through this wrapper (as opposed to internal recipe
    # builds, which already had this flag) failed with "undefined symbol:
    # __gxx_personality_seh0" -- every .xdata entry in the client object
    # still expected the SEH personality this project's runtime never
    # exports.
    common_flags="$common_flags -fdwarf-exceptions"
    # See the matching comment in tools/crt-cc: also define
    # __MINGW32_MAJOR_VERSION/__MINGW32_MINOR_VERSION to match a real
    # mingw-w64 install, since clang's own predefined macro set for this
    # target stops at __MINGW32__ and leaves those two undefined.
    common_flags="$common_flags -D__MINGW32_MAJOR_VERSION=3 -D__MINGW32_MINOR_VERSION=11"
    # libcxx/include/__config's _LIBCPP_DLL_VIS only has two states on
    # Windows: __declspec(dllexport) when _LIBCPP_BUILDING_LIBRARY is
    # defined (building the library itself -- CRT_CXX_BUILDING_RUNTIME=1,
    # handled entirely by this recipe's own CMake options, untouched
    # here), or __declspec(dllimport) otherwise -- for EVERY consumer,
    # with no third state for "consuming the static archive." A client
    # linking libc++.a directly (this project's own default, non-shared
    # CRT_CXX_RUNTIME_LINKAGE) has no import thunks to satisfy those
    # dllimport-decorated declarations at all, so linking fails with
    # "undefined symbol: __declspec(dllimport) ..." even though the real,
    # non-decorated symbol is right there in libc++.a -- confirmed for
    # real via lld's own diagnostic naming the exact archive and mangled
    # symbol. _LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS is libcxx's own
    # documented escape hatch for exactly this: it drops _LIBCPP_DLL_VIS
    # (and its siblings) to nothing, matching how a plain static archive
    # is supposed to be consumed -- direct symbol resolution, no DLL
    # boundary at all. Shared consumers keep the real dllimport
    # decoration (correct, and required) unchanged.
    if [ "${CRT_CXX_BUILDING_RUNTIME:-0}" != 1 ] && [ "$runtime_linkage" != shared ]; then
      common_flags="$common_flags -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS"
    fi
    ;;
esac

# See the matching comment in tools/crt-cc: resource_dir is passed as its
# own quoted argument pair directly on each exec line, not folded into
# $common_flags, because a stock Windows LLVM install's resource-dir is
# almost always under "C:\Program Files\...", which the unquoted-
# expansion this script otherwise relies on would silently split apart.
if [ "$compile_only" -eq 1 ]; then
  if [ -n "$resource_dir" ]; then
    # shellcheck disable=SC2086
    exec "$cxx" $common_flags -isystem "${resource_dir}/include" $user_args
  fi
  # shellcheck disable=SC2086
  exec "$cxx" $common_flags $user_args
fi

# See the matching comment in tools/crt-cc for why shared_mode changes
# which start object/entry-point flags apply.
if [ "$shared_mode" -eq 1 ]; then
  libs="-L${CRT_SYSROOT}/lib"
else
  libs="${CRT_SYSROOT}/lib/crt1.o -L${CRT_SYSROOT}/lib"
fi
# See the matching declaration in tools/crt-cc: prelibs holds objects that
# must land on the link line *before* $user_args -- currently only
# Windows' .ctors/.dtors "begin" sentinel needs this (see the windows)
# case's own comment below). Empty everywhere else.
prelibs=""
# See the matching comment in tools/crt-cc: on Linux, the static archives
# are only safe to link into an executable (never compiled with -fPIC),
# so shared_mode links the already-built shared counterparts instead.
# macOS is passed static archives in both modes -- see tools/crt-cc's own
# comment for why, and why it still needs -rpath in shared_mode anyway
# (a stray bare -lc-style flag from some upstream build can still pull in
# this project's own libc.dylib, which sits right next to libc.a in the
# sysroot, ahead of the static archive per ld64's default -l resolution).
case "$target_os" in
  macos)
    if [ "${CRT_CXX_BUILDING_RUNTIME:-0}" = 1 ]; then
      cxx_runtime_libs=""
    elif [ "$runtime_linkage" = shared ]; then
      if [ ! -f "${CRT_SYSROOT}/lib/libc++.dylib" ] ||
         [ ! -f "${CRT_SYSROOT}/lib/libc++abi.dylib" ]; then
        echo "crt-c++: imported shared libc++ runtime is not staged" >&2
        exit 1
      fi
      cxx_runtime_libs="${CRT_SYSROOT}/lib/libc++.dylib ${CRT_SYSROOT}/lib/libc++abi.dylib"
    else
      cxx_abi_lib=""
      if [ -f "${CRT_SYSROOT}/lib/libc++abi.a" ]; then
        cxx_abi_lib="${CRT_SYSROOT}/lib/libc++abi.a"
      fi
      notweak_list="${CRT_SYSROOT}/lib/libc++.notweak.exp"
      if [ ! -f "$notweak_list" ]; then
        echo "crt-c++: imported static libc++ Darwin link metadata is not staged" >&2
        exit 1
      fi
      # Darwin's libSystem also exports C++ allocation symbols. Pull the
      # allocation object from libc++.a and apply libc++'s own Darwin
      # not-weak policy so dyld cannot interpose the host C++ runtime. Avoid
      # force-loading the whole archive: that would run unused iostream
      # initializers and change ordinary static archive semantics.
      cxx_runtime_libs="-Wl,-u,__Znwm -Wl,-u,__ZnwmSt11align_val_t -Wl,-force_symbols_not_weak_list,$notweak_list ${CRT_SYSROOT}/lib/libc++.a $cxx_abi_lib"
    fi
    if [ "$shared_mode" -eq 1 ] || [ "$runtime_linkage" = shared ]; then
      crt_core_libs="${CRT_SYSROOT}/lib/libc.dylib ${CRT_SYSROOT}/lib/libm.dylib ${CRT_SYSROOT}/lib/libdl.dylib"
    else
      crt_core_libs="${CRT_SYSROOT}/lib/libc.a ${CRT_SYSROOT}/lib/libm.a ${CRT_SYSROOT}/lib/libdl.a"
    fi
    libs="$libs $cxx_runtime_libs $crt_core_libs ${CRT_SYSROOT}/lib/libclang_rt.builtins.a -lSystem"
    if [ "$shared_mode" -eq 1 ]; then
      entry="-Wl,-dead_strip"
    else
      entry="-Wl,-e,_start -Wl,-dead_strip"
    fi
    if [ "$runtime_linkage" = shared ]; then
      entry="$entry -Wl,-rpath,${CRT_SYSROOT}/lib"
    fi
    ;;
  linux)
    if [ "${CRT_CXX_BUILDING_RUNTIME:-0}" = 1 ]; then
      cxx_runtime_libs=""
    elif [ "$runtime_linkage" = shared ]; then
      cxx_abi_lib=""
      if [ -f "${CRT_SYSROOT}/lib/libc++abi.so" ]; then
        cxx_abi_lib="${CRT_SYSROOT}/lib/libc++abi.so"
      fi
      # libunwind (Linux only -- see libstdc++/third_party/libunwind/
      # recipe.json's own notes for why macOS never builds/needs one, and
      # libstdc++/third_party/libcxxabi/recipe.json's notes for why the
      # link dependency has to be added here rather than inside
      # libcxxabi's own standalone CMake build). Only present at all once
      # CRT_USE_IMPORTED_LIBCXX=ON has actually staged it; conditional the
      # same way cxx_abi_lib above already is, so the bootstrap
      # libstdc++/src/ ABI shim (which never stages a libunwind.so) keeps
      # linking exactly as before.
      cxx_unwind_lib=""
      if [ -f "${CRT_SYSROOT}/lib/libunwind.so" ]; then
        cxx_unwind_lib="${CRT_SYSROOT}/lib/libunwind.so"
      fi
      cxx_runtime_libs="${CRT_SYSROOT}/lib/libc++.so $cxx_abi_lib $cxx_unwind_lib"
    else
      cxx_abi_lib=""
      if [ -f "${CRT_SYSROOT}/lib/libc++abi.a" ]; then
        cxx_abi_lib="${CRT_SYSROOT}/lib/libc++abi.a"
      fi
      cxx_unwind_lib=""
      if [ -f "${CRT_SYSROOT}/lib/libunwind.a" ]; then
        cxx_unwind_lib="${CRT_SYSROOT}/lib/libunwind.a"
      fi
      cxx_runtime_libs="${CRT_SYSROOT}/lib/libc++.a $cxx_abi_lib $cxx_unwind_lib"
    fi
    if [ "$shared_mode" -eq 1 ]; then
      crt_libs="$cxx_runtime_libs ${CRT_SYSROOT}/lib/libc.so ${CRT_SYSROOT}/lib/libm.so ${CRT_SYSROOT}/lib/libdl.so"
      libs="$libs $crt_libs ${CRT_SYSROOT}/lib/libclang_rt.builtins.a"
    else
      crt_libs="$cxx_runtime_libs ${CRT_SYSROOT}/lib/libc.a ${CRT_SYSROOT}/lib/libm.a ${CRT_SYSROOT}/lib/libdl.a"
      # __crt_run_init_array()/__crt_run_fini_array() (see the matching
      # comment in tools/crt-cc, and libc/src/arch/linux/common/
      # init_fini_array.c itself): must be linked directly into every
      # executable, alongside crt1.o itself, so its __init_array_start/
      # __init_array_end boundary symbols always reflect the calling
      # executable's own link -- not some other DSO's -- regardless of
      # whether libc itself ends up static or shared here. A -shared
      # build has no equivalent need (a shared object's own .init_array
      # is handled by the OS's dynamic loader when it's loaded, not by
      # this project's own startup code), matching why crt1.o itself is
      # skipped in that case too. tools/crt-cc already carries this line;
      # this wrapper never got the C++ copy, which is exactly what left
      # every out-of-tree static C++ link (e.g. crt-libcxx-smoke) with an
      # undefined reference to __crt_run_init_array.
      libs="$libs ${CRT_SYSROOT}/lib/crt1_init_array.o"
      # See the matching comment in tools/crt-cc: libdl.a's getauxval()
      # call and libclang_rt.builtins.a's aarch64 outline-atomics
      # __getauxval() call both resolve against libc.a, but both are
      # listed after libc.a here -- past ld/lld's default single
      # left-to-right archive scan by the time either is reached.
      # --start-group/--end-group makes the whole set resolve regardless
      # of order.
      libs="$libs -Wl,--start-group $crt_libs ${CRT_SYSROOT}/lib/libclang_rt.builtins.a -Wl,--end-group"
    fi
    if [ "$shared_mode" -eq 1 ]; then
      # See the matching comment in tools/crt-cc: bake this project's own
      # sysroot lib dir into DT_RUNPATH so the loader finds this
      # project's real libc.so/etc there instead of colliding with an
      # unrelated same-named file (e.g. Ubuntu/Debian's libc6-dev
      # link-time-only linker script at /lib/aarch64-linux-gnu/libc.so)
      # on the host's own default search path.
      entry="-Wl,--gc-sections -Wl,-rpath,${CRT_SYSROOT}/lib"
    else
      entry="-Wl,-e,_start -Wl,--gc-sections"
    fi
    if [ "$runtime_linkage" = shared ]; then
      entry="$entry -Wl,-rpath,${CRT_SYSROOT}/lib"
    fi
    ;;
  windows)
    if [ "${CRT_CXX_BUILDING_RUNTIME:-0}" = 1 ] && [ -n "$resource_dir" ]; then
      # -nostdlib deliberately suppresses Clang's automatic compiler-rt
      # addition.  Runtime libraries nevertheless may lower 128-bit
      # arithmetic to helpers such as __divti3, so link the matching
      # compiler-owned builtins archive explicitly while bootstrapping
      # libc++/libc++abi. Prefer the MinGW target archive, then the stock
      # Windows archive supplied by an MSVC-layout LLVM installation.
      for candidate in \
        "${resource_dir}/lib/${target_arch}-w64-windows-gnu/libclang_rt.builtins.a" \
        "${resource_dir}/lib/windows/clang_rt.builtins-${target_arch}.lib"; do
        if [ -f "$candidate" ]; then
          compiler_rt_builtins="$candidate"
          break
        fi
      done
    fi
    if [ "${CRT_CXX_BUILDING_RUNTIME:-0}" = 1 ]; then
      cxx_runtime_libs=""
    elif [ "$runtime_linkage" = shared ]; then
      cxx_runtime_libs=""
      for candidate in libc++.dll.a libc++_dll.lib c++_dll.lib; do
        if [ -f "${CRT_SYSROOT}/lib/$candidate" ]; then
          cxx_runtime_libs="${CRT_SYSROOT}/lib/$candidate"
          break
        fi
      done
      if [ -z "$cxx_runtime_libs" ]; then
        echo "crt-c++: imported shared libc++ import library is not staged" >&2
        exit 1
      fi
      # libc++abi's own import library: unlike libc++.dll.a above, this
      # was missing entirely until now -- the static branch just below
      # already links libc++abi.a alongside libc++.a, but nothing mirrored
      # that for the shared case. Confirmed for real: a real client linked
      # shared failed with "undefined symbol: __cxa_throw"/__cxa_begin_
      # catch/__gxx_personality_v0/vtable for std::length_error and
      # __cxxabiv1::__*_type_info -- all genuinely exported from libc++abi.
      # dll.a (verified directly with llvm-nm), just never linked in here.
      # libc++.dll does not itself re-export libc++abi's own symbols
      # through to a client that only links libc++.dll.a; a client using
      # exceptions/RTTI needs both DLLs' import libraries directly, same
      # as the static case already needs both archives.
      for candidate in libc++abi.dll.a libc++abi_dll.lib c++abi_dll.lib; do
        if [ -f "${CRT_SYSROOT}/lib/$candidate" ]; then
          cxx_runtime_libs="$cxx_runtime_libs ${CRT_SYSROOT}/lib/$candidate"
          break
        fi
      done
      # libunwind (Linux/Windows only -- see libstdc++/third_party/
      # libunwind/recipe.json's own notes for why macOS never builds one).
      # Optional, unlike libc++'s own import library just above: absent
      # whenever CRT_USE_IMPORTED_LIBCXX=ON hasn't (yet, or ever, on this
      # host) actually staged it, matching the bootstrap libstdc++/src/ ABI
      # shim's own no-libunwind link line.
      for candidate in libunwind.dll.a libunwind_dll.lib unwind_dll.lib unwind.lib; do
        if [ -f "${CRT_SYSROOT}/lib/$candidate" ]; then
          cxx_runtime_libs="$cxx_runtime_libs ${CRT_SYSROOT}/lib/$candidate"
          break
        fi
      done
    elif [ -f "${CRT_SYSROOT}/lib/libc++.a" ]; then
      cxx_runtime_libs="${CRT_SYSROOT}/lib/libc++.a"
      if [ -f "${CRT_SYSROOT}/lib/libc++abi.a" ]; then
        cxx_runtime_libs="$cxx_runtime_libs ${CRT_SYSROOT}/lib/libc++abi.a"
      fi
      if [ -f "${CRT_SYSROOT}/lib/libunwind.a" ]; then
        cxx_runtime_libs="$cxx_runtime_libs ${CRT_SYSROOT}/lib/libunwind.a"
      fi
    else
      cxx_runtime_libs="${CRT_SYSROOT}/lib/c++.lib"
    fi
    if [ "$shared_mode" -eq 1 ]; then
      crt_core_libs="${CRT_SYSROOT}/lib/c_dll.lib ${CRT_SYSROOT}/lib/m_dll.lib ${CRT_SYSROOT}/lib/dl_dll.lib"
      # crt1_pseudo_reloc.o (_pei386_runtime_relocator(), see that file's
      # own comment): dllcrt.c's crtDllMainCRTStartup() now calls this on
      # DLL_PROCESS_ATTACH, the DLL analogue of crt1.c's own executable-
      # startup call below. Needed the moment any cross-DLL GNU-ld-auto-
      # imported data reference appears in a shared build (confirmed for
      # real: libc++.dll importing from libunwind.dll -- "output image
      # has runtime pseudo relocations, but the function
      # _pei386_runtime_relocator is missing" the first time that
      # happened); harmless to always link in otherwise, matching the
      # executable path's own always-linked precedent.
      # crt1_dwarf_safety_net.o (_crt_install_dwarf_unwind_safety_net(),
      # see that file's own top comment): dllcrt.c's crtDllMainCRTStartup()
      # calls this too now, right after _pei386_runtime_relocator() above --
      # a shared libc++.dll/libc++abi.dll/libunwind.dll is exactly the
      # DWARF-compiled code TODO.md item 7's safety net exists for.
      libs="${CRT_SYSROOT}/lib/dllcrt.o ${CRT_SYSROOT}/lib/crt1_pseudo_reloc.o ${CRT_SYSROOT}/lib/crt1_dwarf_safety_net.o $libs $cxx_runtime_libs $crt_core_libs ${CRT_WINDOWS_SYSTEM_LIBS:--Wl,kernel32.lib -Wl,synchronization.lib}"
      # --exclude-symbols: see the matching, fuller comment in
      # tools/crt-cc's own shared_mode branch -- both objects above
      # define plain global startup-hook functions that must never
      # become part of any DLL's own auto-exported public surface;
      # confirmed for real as a genuine "duplicate symbol" link failure
      # for _crt_install_dwarf_unwind_safety_net the moment two shared
      # DLLs built through this project's own GNU-ABI -shared path are
      # chained together in one process (one importing the other).
      entry="-Wl,--exclude-symbols=_pei386_runtime_relocator -Wl,--exclude-symbols=_crt_install_dwarf_unwind_safety_net -Wl,/entry:crtDllMainCRTStartup -Wl,/DLL -Wl,/OPT:REF -fuse-ld=lld"
    else
      libs="$libs $cxx_runtime_libs ${CRT_SYSROOT}/lib/c.lib ${CRT_SYSROOT}/lib/m.lib ${CRT_SYSROOT}/lib/dl.lib ${CRT_WINDOWS_SYSTEM_LIBS:--Wl,kernel32.lib -Wl,synchronization.lib}"
      entry="-Wl,/entry:mainCRTStartup -Wl,/subsystem:console -Wl,/OPT:REF -fuse-ld=lld"
      # __crt_run_init_array()/__crt_run_fini_array() Windows/PE support,
      # and crt1_pseudo_reloc.o (_pei386_runtime_relocator()): see
      # tools/crt-cc's own matching comment on its identical windows)
      # executable branch -- this project's own C++ executables need
      # exactly the same prelibs set crt-cc's C executables already get,
      # and this script had never actually linked one until now (every
      # prior Windows C++ link through this wrapper was either
      # CRT_CXX_BUILDING_RUNTIME=1 or shared_mode). Confirmed for real:
      # "undefined symbol: _pei386_runtime_relocator, referenced by
      # crt1.c:117:(mainCRTStartup)" the first time a real Windows C++
      # executable was linked through this wrapper.
      # crt1_dwarf_safety_net.o (_crt_install_dwarf_unwind_safety_net(),
      # TODO.md item 7's native-callback/boundary safety net -- see that
      # file's own top comment for the full empirical design story):
      # rides along here too, same reasoning as crt1_pseudo_reloc.o.
      prelibs="${CRT_SYSROOT}/lib/crt1_ctors_begin.o ${CRT_SYSROOT}/lib/crt1_ctors_walker.o ${CRT_SYSROOT}/lib/crt1_pseudo_reloc.o ${CRT_SYSROOT}/lib/crt1_dwarf_safety_net.o"
      libs="$libs ${CRT_SYSROOT}/lib/crt1_ctors_end.o"
    fi
    ;;
  *)
    echo "crt-c++: unsupported CRT_TARGET_OS=$target_os" >&2
    exit 1
    ;;
esac

# See tools/crt-cc's matching comment: -Wl,/libpath:... is passed as its
# own quoted argument directly on each exec line below, not folded into
# $libs, for the same "Program Files (x86)" reason resource_dir already
# gets this treatment -- $libs is expanded unquoted (relying on word
# splitting, like every other flag accumulator in this script), which
# would otherwise tear a space-containing Windows SDK path into multiple
# broken argv entries. Confirmed for real: this exact bug broke linking
# libc++abi.dll, clang reporting "no such file or directory: 'Files'" for
# a linker-flag argument that had already lost its own spaces.
if [ -n "$compiler_rt_builtins" ]; then
  if [ -n "${CRT_WINDOWS_SDK_LIBPATH:-}" ]; then
    if [ -n "$resource_dir" ]; then
      # shellcheck disable=SC2086
      exec "$cxx" $common_flags -isystem "${resource_dir}/include" -nostdlib -nostartfiles -nodefaultlibs $entry $prelibs $user_args $libs "$compiler_rt_builtins" "-Wl,/libpath:${CRT_WINDOWS_SDK_LIBPATH}"
    fi
    # shellcheck disable=SC2086
    exec "$cxx" $common_flags -nostdlib -nostartfiles -nodefaultlibs $entry $prelibs $user_args $libs "$compiler_rt_builtins" "-Wl,/libpath:${CRT_WINDOWS_SDK_LIBPATH}"
  fi
