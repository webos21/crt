#!/bin/sh
set -eu

if [ -z "${CRT_SYSROOT:-}" ]; then
  echo "crt-c++: CRT_SYSROOT is not set" >&2
  exit 1
fi

target_os="${CRT_TARGET_OS:-}"
if [ -z "$target_os" ]; then
  case "$(uname -s)" in
    Darwin) target_os=macos ;;
    Linux) target_os=linux ;;
    MINGW*|MSYS*|CYGWIN*) target_os=windows ;;
    *) target_os=unknown ;;
  esac
fi

cxx="${CRT_HOST_CXX:-clang++}"
if [ "$target_os" = windows ]; then
  export CRT_SPAWN_NATIVE_WINDOWS=1
  target_arch="${CRT_TARGET_ARCH:-}"
  if [ -z "$target_arch" ]; then
    # See the matching comment in tools/crt-cc: check both `uname -m` and
    # `uname -s` together so this works under either this project's own
    # toybox `uname` or a host MSYS/Git-Bash `uname`.
    case "$(uname -m 2>/dev/null)$(uname -s 2>/dev/null)" in
      *aarch64*|*arm64*|*ARM64*) target_arch=aarch64 ;;
      *) target_arch=x86_64 ;;
    esac
  fi
fi
set +e
resource_dir="$("$cxx" -print-resource-dir 2>/dev/null)"
set -e

windows_host_arg() {
  case "$1" in
    /*)
      if [ -n "${CRT_ROOTFS:-}" ]; then
        rootfs=$(printf '%s\n' "$CRT_ROOTFS" | sed 's|\\|/|g')
        printf '%s/%s\n' "$rootfs" "${1#/}"
      else
        printf '%s\n' "$1"
      fi
      ;;
    -I/*|-L/*)
      prefix=${1%%/*}
      path=/${1#*/}
      if [ -n "${CRT_ROOTFS:-}" ]; then
        rootfs=$(printf '%s\n' "$CRT_ROOTFS" | sed 's|\\|/|g')
        printf '%s%s/%s\n' "$prefix" "$rootfs" "${path#/}"
      else
        printf '%s\n' "$1"
      fi
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

user_args=""
for arg in "$@"; do
  if [ "$target_os" = windows ]; then
    arg=$(windows_host_arg "$arg")
  fi
  user_args="$user_args $(printf '%s\n' "$arg")"
done

compile_only=0
for arg in "$@"; do
  case "$arg" in
    -c|-E|-S) compile_only=1 ;;
  esac
done

common_flags="-ffreestanding -fno-builtin -Xclang -fwchar-type=int -ffunction-sections -fdata-sections -fno-exceptions -fno-rtti -nostdinc -nostdinc++ -isystem${CRT_SYSROOT}/include"
case "$target_os" in
  macos) common_flags="$common_flags -DCRT_TARGET_OS_MACOS=1" ;;
  linux) common_flags="$common_flags -DCRT_TARGET_OS_LINUX=1" ;;
  windows)
    # See the matching comment in tools/crt-cc: without an explicit
    # --target, a stock Windows LLVM install's clang++.exe defaults to
    # *-pc-windows-msvc, whose predefined macros (_MSC_VER, no __GNUC__)
    # mislead third-party autoconf/libtool ports into picking the wrong,
    # MSVC-native build path. *-w64-mingw32 matches what those ports'
    # `configure` scripts (and this project's own --build=*-w64-mingw32
    # recipe workarounds) already expect.
    common_flags="$common_flags -DCRT_TARGET_OS_WINDOWS=1 -fno-threadsafe-statics --target=${target_arch}-w64-mingw32"
    ;;
esac

# See the matching comment in tools/crt-cc: resource_dir is passed as its
# own quoted argument pair directly on each exec line, not folded into
# $common_flags, because a stock Windows LLVM install's resource-dir is
# almost always under "C:\Program Files\...", which the unquoted-
# expansion this script otherwise relies on would silently split apart.
if [ "$compile_only" -eq 1 ]; then
  if [ -n "$resource_dir" ]; then
    # shellcheck disable=SC2086
    exec "$cxx" $common_flags -isystem "${resource_dir}/include" $user_args
  fi
  # shellcheck disable=SC2086
  exec "$cxx" $common_flags $user_args
fi

libs="${CRT_SYSROOT}/lib/crt1.o -L${CRT_SYSROOT}/lib"
case "$target_os" in
  macos)
    libs="$libs ${CRT_SYSROOT}/lib/libc++.a ${CRT_SYSROOT}/lib/libc.a ${CRT_SYSROOT}/lib/libm.a ${CRT_SYSROOT}/lib/libdl.a ${CRT_SYSROOT}/lib/libclang_rt.builtins.a -lSystem"
    entry="-Wl,-e,_start -Wl,-dead_strip"
    ;;
  linux)
    libs="$libs ${CRT_SYSROOT}/lib/libc++.a ${CRT_SYSROOT}/lib/libc.a ${CRT_SYSROOT}/lib/libm.a ${CRT_SYSROOT}/lib/libdl.a ${CRT_SYSROOT}/lib/libclang_rt.builtins.a"
    entry="-Wl,-e,_start -Wl,--gc-sections"
    ;;
  windows)
    if [ -n "${CRT_WINDOWS_SDK_LIBPATH:-}" ]; then
      libs="$libs -Wl,/libpath:${CRT_WINDOWS_SDK_LIBPATH}"
    fi
    libs="$libs ${CRT_SYSROOT}/lib/c++.lib ${CRT_SYSROOT}/lib/c.lib ${CRT_SYSROOT}/lib/m.lib ${CRT_SYSROOT}/lib/dl.lib ${CRT_WINDOWS_SYSTEM_LIBS:--Wl,kernel32.lib -Wl,synchronization.lib}"
    entry="-Wl,/entry:mainCRTStartup -Wl,/subsystem:console -Wl,/OPT:REF -fuse-ld=lld"
    ;;
  *)
    echo "crt-c++: unsupported CRT_TARGET_OS=$target_os" >&2
    exit 1
    ;;
esac

if [ -n "$resource_dir" ]; then
  # shellcheck disable=SC2086
  exec "$cxx" $common_flags -isystem "${resource_dir}/include" -nostdlib -nostartfiles -nodefaultlibs $entry $user_args $libs
fi
# shellcheck disable=SC2086
exec "$cxx" $common_flags -nostdlib -nostartfiles -nodefaultlibs $entry $user_args $libs
