    "Source/cmake/WebKitVersion.cmake": "set(_version_xcconfig \"${CMAKE_SOURCE_DIR}/Configurations/Version.xcconfig\")\nif (EXISTS \"${_version_xcconfig}\")\n    file(STRINGS \"${_version_xcconfig}\" _version_lines)\n    foreach (_line IN LISTS _version_lines)\n        if (_line MATCHES \"^MAJOR_VERSION = ([0-9]+)\")\n            set(_major \"${CMAKE_MATCH_1}\")\n        elseif (_line MATCHES \"^MINOR_VERSION = ([0-9]+)\")\n            set(_minor \"${CMAKE_MATCH_1}\")\n        elseif (_line MATCHES \"^TINY_VERSION = ([0-9]+)\")\n            set(_tiny \"${CMAKE_MATCH_1}\")\n        endif ()\n    endforeach ()\n    if (DEFINED _major AND DEFINED _minor AND DEFINED _tiny)\n        set(WEBKIT_MAC_VERSION \"${_major}.${_minor}.${_tiny}\")\n        set(MACOSX_FRAMEWORK_BUNDLE_VERSION \"${_major}.${_minor}.${_tiny}+\")\n    else ()\n        message(WARNING \"Version.xcconfig found but could not parse MAJOR/MINOR/TINY_VERSION\")\n        set(WEBKIT_MAC_VERSION 620.0.0)\n        set(MACOSX_FRAMEWORK_BUNDLE_VERSION 620.0.0+)\n    endif ()\n    unset(_version_lines)\n    unset(_major)\n    unset(_minor)\n    unset(_tiny)\n    unset(_line)\nelse ()\n    message(WARNING \"Configurations/Version.xcconfig not found, using fallback version\")\n    set(WEBKIT_MAC_VERSION 620.0.0)\n    set(MACOSX_FRAMEWORK_BUNDLE_VERSION 620.0.0+)\nendif ()\nunset(_version_xcconfig)\n",
