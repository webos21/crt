+#if PLATFORM(CRT)
+void WebPage::setCompositionCRT(const String& text, uint64_t selectionStart, uint64_t selectionLength)
+{
+    RefPtr frame = corePage()->focusController().focusedOrMainFrame();
+    if (!frame)
+        return;
+
+    Ref editor = frame->editor();
+    if (!editor->canEdit())
+        return;
+
+    if (text.isEmpty()) {
+        // Cancel: replace the marked text with nothing and end the composition (Editor::
+        // cancelComposition leaves the marked characters in the field).
+        editor->setComposition(emptyString(), { }, { }, { }, 0, 0);
+        editor->confirmComposition();
+        return;
+    }
+    Vector<CompositionUnderline> underlines;
+    underlines.append(CompositionUnderline(0, text.length(), CompositionUnderlineColor::TextColor, Color(Color::black), false));
+    editor->setComposition(text, underlines, { }, { }, selectionStart, selectionStart + selectionLength);
+}
+
+void WebPage::confirmCompositionCRT(const String& text)
+{
+    RefPtr frame = corePage()->focusController().focusedOrMainFrame();
+    if (!frame)
+        return;
+
+    Ref editor = frame->editor();
+    if (!editor->canEdit())
+        return;
+
+    if (text.isNull())
+        editor->confirmComposition();
+    else
+        editor->confirmComposition(text);
+}
+
+void WebPage::insertTextCRT(const String& text)
+{
+    RefPtr frame = corePage()->focusController().focusedOrMainFrame();
+    if (!frame)
+        return;
+
+    Ref editor = frame->editor();
+    if (!editor->canEdit())
+        return;
+
+    editor->insertText(text, nullptr);
+}
+#endif
