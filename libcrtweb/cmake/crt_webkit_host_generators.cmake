# Build-host adaptation only: leave pinned WebKit sources and target ABI alone.
include_guard(GLOBAL)
if(NOT CMAKE_HOST_WIN32)
  return()
endif()

function(_crt_generator_json_string value output)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Compiler response files do not cover custom commands. The serializer input
# list exceeds cmd.exe's 8191 and CreateProcessW's 32767-character limits.
# Load argv in the Python adapter process; preserve the rest of the command.
function(_crt_generator_cmake_argument value output)
  set(_equals "")
  while(TRUE)
    string(FIND "${value}" "]${_equals}]" _closing)
    if(_closing EQUAL -1)
      break()
    endif()
    string(APPEND _equals "=")
  endwhile()
  set(${output} "[${_equals}[${value}]${_equals}]" PARENT_SCOPE)
endfunction()

function(add_custom_command)
  # ARGV as a list would lose empty arguments, semicolons and trailing
  # backslashes. Read ARGV<n> individually and forward with bracket quoting.
  set(_script_index -1)
  set(_scan 2)
  while(_scan LESS ARGC)
    set(_arg "${ARGV${_scan}}")
    if(_arg MATCHES "[/\\]generate-serializers\\.py$")
      math(EXPR _before "${_scan} - 2")
      if("${ARGV${_before}}" STREQUAL "COMMAND")
        set(_script_index ${_scan})
        break()
      endif()
    endif()
    math(EXPR _scan "${_scan} + 1")
  endwhile()
  if(NOT _script_index EQUAL -1)
    math(EXPR _python_index "${_script_index} - 1")
    set(_end ${_script_index})
    set(_json "[")
    set(_separator "")
    while(_end LESS ARGC)
      set(_arg "${ARGV${_end}}")
      if(_arg MATCHES "^(COMMAND|DEPENDS|WORKING_DIRECTORY|COMMENT|VERBATIM|USES_TERMINAL|COMMAND_EXPAND_LISTS|JOB_POOL|JOB_SERVER_AWARE|DEPFILE|IMPLICIT_DEPENDS|MAIN_DEPENDENCY|BYPRODUCTS|APPEND|CODEGEN|DEPENDS_EXPLICIT_ONLY)$")
        break()
      endif()
      _crt_generator_json_string("${_arg}" _quoted)
      string(APPEND _json "${_separator}${_quoted}")
      set(_separator ",")
      math(EXPR _end "${_end} + 1")
    endwhile()
    string(APPEND _json "]\n")
    string(SHA256 _identity "${_json}")
    set(_argv "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/crt-host-generators/${_identity}.json")
    set(_previous "")
    if(EXISTS "${_argv}")
      file(READ "${_argv}" _previous)
    endif()
    if(NOT _previous STREQUAL _json)
      file(WRITE "${_argv}" "${_json}")
    endif()
    set(_runner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/crt_webkit_run_generator.py")
  endif()
  set(_forward "_add_custom_command(\n")
  set(_index 0)
  while(_index LESS ARGC)
    if(NOT _script_index EQUAL -1 AND _index EQUAL _python_index)
      _crt_generator_cmake_argument("${ARGV${_index}}" _quoted)
      string(APPEND _forward "${_quoted}\n")
      _crt_generator_cmake_argument("${_runner}" _quoted)
      string(APPEND _forward "${_quoted}\n")
      _crt_generator_cmake_argument("${_argv}" _quoted)
      string(APPEND _forward "${_quoted}\n")
      set(_index ${_end})
    else()
      _crt_generator_cmake_argument("${ARGV${_index}}" _quoted)
      string(APPEND _forward "${_quoted}\n")
      math(EXPR _index "${_index} + 1")
    endif()
  endwhile()
  if(NOT _script_index EQUAL -1)
    _crt_generator_cmake_argument("${_runner}" _quoted)
    string(APPEND _forward "DEPENDS\n${_quoted}\n")
    _crt_generator_cmake_argument("${_argv}" _quoted)
    string(APPEND _forward "${_quoted}\n")
  endif()
  string(APPEND _forward ")")
  cmake_language(EVAL CODE "${_forward}")
endfunction()
