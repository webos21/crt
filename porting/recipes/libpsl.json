{
  "schema_version": 1,
  "name": "libpsl",
  "version": "0.23.3",
  "group": "web",
  "source": {
    "url": "https://github.com/rockdaboot/libpsl/releases/download/0.23.3/libpsl-0.23.3.tar.gz",
    "archive": "libpsl-0.23.3.tar.gz",
    "source_dir": "libpsl-0.23.3",
    "sha256": "93941f85a1e7bd593fa94f299233cb5dfc91cd144fd9a78a6ceb75001c5b03be"
  },
  "dependencies": [
    "make",
    "icu"
  ],
  "build": {
    "system": "configure",
    "sysroot_stage": "02-cxx",
    "configure_args": [
      "--disable-man",
      "--disable-gtk-doc",
      "--disable-tests",
      "--enable-runtime=libicu",
      "--enable-builtin=libicu"
    ],
    "env": {
      "CFLAGS": "-O2",
      "PKG_CONFIG_LIBDIR": "@PORT_PREFIX@/lib/pkgconfig",
      "PKG_CONFIG_PATH": "@PORT_PREFIX@/lib/pkgconfig"
    },
    "make_args": [],
    "target_overrides": {
      "linux": {
        "env": {
          "LDFLAGS": "-Wl,--allow-shlib-undefined"
        }
      },
      "windows": {
        "configure_args": [
          "--build=@CRT_MINGW_TRIPLE@"
        ],
        "env": {
          "CFLAGS": "-U_WIN32 -U_WIN32_WCE -U__WIN32__ -UWIN32 -U__NT__ -U_MSC_VER",
          "lt_cv_deplibs_check_method": "pass_all"
        },
        "force_include": [
          "porting/shims/win32/libtool_wrapper_compat.h"
        ]
      }
    }
  },
  "tests": [
    {
      "name": "suffix-shared",
      "type": "compile-run",
      "source": "porting/tests/libpsl_suffix_test.c",
      "cflags": [
        "-I@PORT_PREFIX@/include"
      ],
      "link_args": [],
      "expect_stdout": "libpsl_suffix_test: ok",
      "target_overrides": {
        "linux": {
          "link_args": [
            "@PORT_PREFIX@/lib/libpsl.so",
            "-Wl,--allow-shlib-undefined"
          ]
        },
        "macos": {
          "link_args": [
            "@PORT_PREFIX@/lib/libpsl.dylib"
          ],
          "env": {
            "CRT_CXX_RUNTIME_LINKAGE": "shared"
          }
        },
        "windows": {
          "cflags": [
            "-U_WIN32",
            "-U_WIN32_WCE",
            "-U__WIN32__",
            "-UWIN32",
            "-U__NT__",
            "-U_MSC_VER"
          ],
          "link_args": [
            "@PORT_PREFIX@/lib/libpsl.dll.a",
            "@PORT_PREFIX@/lib/libicuuc.dll.a",
            "@PORT_PREFIX@/lib/libicudt.dll.a"
          ]
        }
      }
    }
  ],
  "status": {
    "linux": "shared-pass",
    "macos": "shared-pass"
  },
  "notes": [
    "Added 2026-10-10 for Web Tranche 3B milestone B2: WebKit's curl backend (PublicSuffixStoreCurl, platform/Curl.cmake links LibPSL::LibPSL) needs libpsl >= 0.20.2.",
    "runtime and builtin IDNA use ICU (the CRT icu port, found through its pkg-config files; PKG_CONFIG_LIBDIR is limited to the port prefix so a host ICU is never picked up). The built-in list is generated from list/public_suffix_list.dat in the tarball by libpsl's own tool (python3 on the build host).",
    "LDFLAGS=-Wl,--allow-shlib-undefined: the CRT ICU shared libraries reference the loader-provided __tls_get_addr (global-dynamic TLS in ICU and libc++abi; the accepted loader boundary documented in docs/acceptance/crtweb_acceptance.md), which the link of a configure probe cannot resolve at link time.",
    "macOS shared tests run with CRT_CXX_RUNTIME_LINKAGE=shared (test-level env): the executable links libc.dylib, the libc every dylib of the port loads, instead of a second static libc.a (Mach-O two-level namespace: two malloc/pthread registries in one process)."
  ]
}
