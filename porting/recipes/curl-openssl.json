{
  "schema_version": 1,
  "name": "curl-openssl",
  "version": "8.21.0",
  "group": "web",
  "source": {
    "url": "https://curl.se/download/curl-8.21.0.tar.gz",
    "archive": "curl-8.21.0.tar.gz",
    "source_dir": "curl-8.21.0",
    "sha256": "d9b327997999045a24cda50f3983e69e51c516bd8be6ef9842fc7f99135e33bb",
    "sha1": "c4a973118684745cb03c38987d131ccbce9e7ab1",
    "md5": "6e50e38c398737269ec002749bcc5d0d"
  },
  "dependencies": [
    "zlib",
    "openssl"
  ],
  "build": {
    "system": "configure",
    "install_subdir": "curl-openssl",
    "configure_args": [
      "--with-openssl=@PORT_PREFIX@",
      "--with-zlib=@PORT_PREFIX@",
      "--without-brotli",
      "--without-zstd",
      "--without-libgsasl",
      "--without-ca-bundle",
      "--without-ca-path",
      "--disable-ldap",
      "--disable-ldaps",
      "--disable-ftp",
      "--disable-telnet",
      "--disable-tftp",
      "--disable-pop3",
      "--disable-imap",
      "--disable-smb",
      "--disable-smtp",
      "--disable-gopher",
      "--disable-mqtt",
      "--disable-rtsp",
      "--disable-dict",
      "--disable-ipfs",
      "--disable-manual",
      "--disable-docs",
      "--without-libpsl"
    ],
    "env": {
      "CFLAGS": "-O2"
    },
    "make_args": [],
    "target_overrides": {
      "macos": {
        "include_dirs": [
          "porting/shims/macos/curl-no-apple-frameworks"
        ],
        "env": {
          "LDFLAGS": "-Wl,-rpath,@PORT_PREFIX@/lib"
        }
      },
      "windows": {
        "configure_args": [
          "--build=@CRT_MINGW_TRIPLE@",
          "ac_cv_header_sys_eventfd_h=no",
          "ac_cv_func_eventfd=no",
          "--disable-shared",
          "--with-openssl"
        ],
        "env": {
          "CFLAGS": "-U_WIN32 -U_WIN64 -U_WIN32_WCE -U__WIN32__ -U__WIN64__ -UWIN32 -UWIN64 -U__MINGW32__ -U__MINGW64__",
          "CPPFLAGS": "-U_WIN32 -U_WIN64 -U_WIN32_WCE -U__WIN32__ -U__WIN64__ -UWIN32 -UWIN64 -U__MINGW32__ -U__MINGW64__",
          "PKG_CONFIG_PATH": "@PORT_PREFIX@/lib/pkgconfig",
          "PKG_CONFIG_LIBDIR": "@PORT_PREFIX@/lib/pkgconfig"
        },
        "force_include": [
          "porting/shims/win32/libtool_wrapper_compat.h"
        ]
      },
      "linux": {
        "env": {
          "LDFLAGS": "-Wl,-rpath,@PORT_PREFIX@/lib"
        }
      }
    }
  },
  "tests": [
    {
      "name": "https-static",
      "type": "compile-run",
      "source": "porting/tests/curl_openssl_https_test.c",
      "cflags": [
        "-I@PORT_PREFIX@/curl-openssl/include",
        "-I@PORT_PREFIX@/include"
      ],
      "link_args": [
        "@PORT_PREFIX@/curl-openssl/lib/libcurl.a",
        "@PORT_PREFIX@/lib/libssl.a",
        "@PORT_PREFIX@/lib/libcrypto.a",
        "@PORT_PREFIX@/lib/libz.a",
        "-lpthread",
        "-ldl"
      ],
      "expect_stdout": "curl_openssl_https_test: ok",
      "library_dirs": [
        "@PORT_PREFIX@/curl-openssl/lib"
      ],
      "target_overrides": {
        "windows": {
          "cflags": [
            "-U_WIN32",
            "-U_WIN64",
            "-U_WIN32_WCE",
            "-U__WIN32__",
            "-U__WIN64__",
            "-UWIN32",
            "-UWIN64",
            "-U__MINGW32__",
            "-U__MINGW64__",
            "-U__NT__",
            "-U_MSC_VER"
          ]
        }
      }
    },
    {
      "name": "https-shared",
      "type": "compile-run",
      "source": "porting/tests/curl_openssl_https_test.c",
      "cflags": [
        "-I@PORT_PREFIX@/curl-openssl/include",
        "-I@PORT_PREFIX@/include"
      ],
      "link_args": [],
      "expect_stdout": "curl_openssl_https_test: ok",
      "library_dirs": [
        "@PORT_PREFIX@/curl-openssl/lib"
      ],
      "target_overrides": {
        "linux": {
          "link_args": [
            "@PORT_PREFIX@/curl-openssl/lib/libcurl.so",
            "@PORT_PREFIX@/lib/libssl.so",
            "@PORT_PREFIX@/lib/libcrypto.so",
            "-lpthread"
          ]
        },
        "macos": {
          "link_args": [
            "@PORT_PREFIX@/curl-openssl/lib/libcurl.dylib",
            "@PORT_PREFIX@/lib/libssl.dylib",
            "@PORT_PREFIX@/lib/libcrypto.dylib",
            "-lpthread"
          ],
          "env": {
            "CRT_CXX_RUNTIME_LINKAGE": "shared"
          }
        },
        "windows": {
          "cflags": [
            "-U_WIN32",
            "-U_WIN64",
            "-U_WIN32_WCE",
            "-U__WIN32__",
            "-U__WIN64__",
            "-UWIN32",
            "-UWIN64",
            "-U__MINGW32__",
            "-U__MINGW64__",
            "-U__NT__",
            "-U_MSC_VER"
          ],
          "skip": "the Windows build is static only (OpenSSL is built no-shared, and the test shares its SSL_CTX with libcurl)"
        }
      }
    },
    {
      "name": "https-ipv6-shared",
      "type": "compile-run",
      "source": "porting/tests/curl_openssl_https_ipv6_test.c",
      "cflags": [
        "-I@PORT_PREFIX@/curl-openssl/include",
        "-I@PORT_PREFIX@/include"
      ],
      "link_args": [],
      "expect_stdout": "curl_openssl_https_ipv6_test: ok",
      "library_dirs": [
        "@PORT_PREFIX@/curl-openssl/lib"
      ],
      "target_overrides": {
        "linux": {
          "link_args": [
            "@PORT_PREFIX@/curl-openssl/lib/libcurl.so",
            "@PORT_PREFIX@/lib/libssl.so",
            "@PORT_PREFIX@/lib/libcrypto.so",
            "-lpthread"
          ]
        },
        "macos": {
          "link_args": [
            "@PORT_PREFIX@/curl-openssl/lib/libcurl.dylib",
            "@PORT_PREFIX@/lib/libssl.dylib",
            "@PORT_PREFIX@/lib/libcrypto.dylib",
            "-lpthread"
          ],
          "env": {
            "CRT_CXX_RUNTIME_LINKAGE": "shared"
          }
        },
        "windows": {
          "cflags": [
            "-U_WIN32",
            "-U_WIN64",
            "-U_WIN32_WCE",
            "-U__WIN32__",
            "-U__WIN64__",
            "-UWIN32",
            "-UWIN64",
            "-U__MINGW32__",
            "-U__MINGW64__",
            "-U__NT__",
            "-U_MSC_VER"
          ],
          "skip": "the Windows build is static only (OpenSSL is built no-shared, and the test shares its SSL_CTX with libcurl)"
        }
      }
    },
    {
      "name": "https-ipv6-static",
      "type": "compile-run",
      "source": "porting/tests/curl_openssl_https_ipv6_test.c",
      "cflags": [
        "-I@PORT_PREFIX@/curl-openssl/include",
        "-I@PORT_PREFIX@/include"
      ],
      "link_args": [
        "@PORT_PREFIX@/curl-openssl/lib/libcurl.a",
        "@PORT_PREFIX@/lib/libssl.a",
        "@PORT_PREFIX@/lib/libcrypto.a",
        "@PORT_PREFIX@/lib/libz.a",
        "-lpthread",
        "-ldl"
      ],
      "expect_stdout": "curl_openssl_https_ipv6_test: ok",
      "library_dirs": [
        "@PORT_PREFIX@/curl-openssl/lib"
      ],
      "target_overrides": {
        "windows": {
          "cflags": [
            "-U_WIN32",
            "-U_WIN64",
            "-U_WIN32_WCE",
            "-U__WIN32__",
            "-U__WIN64__",
            "-UWIN32",
            "-UWIN64",
            "-U__MINGW32__",
            "-U__MINGW64__",
            "-U__NT__",
            "-U_MSC_VER"
          ]
        }
      }
    }
  ],
  "status": {
    "linux": "shared-pass",
    "macos": "shared-pass"
  },
  "notes": [
    "Added 2026-10-10 for Web Tranche 3B milestone B2: WebKit's curl network backend (platform/network/curl: CurlContext, CurlSSLHandle, CurlSSLVerifier) installs an OpenSSL verify callback through CURLOPT_SSL_CTX_FUNCTION, so libcurl must be built with its OpenSSL backend; the `curl` port (mbedTLS, used by libcrtmedia networking) cannot provide it.",
    "Second libcurl in the same sysroot, therefore build.install_subdir: it installs to <prefix>/curl-openssl and the mbedTLS curl keeps <prefix>. WebKit's FindCURL gets CURL_ROOT/CMAKE_PREFIX_PATH pointing at the subdirectory. Same version and source as the curl recipe (8.21.0).",
    "LDFLAGS rpath: libcurl.so is found from <prefix>/curl-openssl/lib but needs libssl/libcrypto from <prefix>/lib.",
    "The CA bundle is not configured here (no --with-ca-bundle): certificate trust is a PlatformCRT decision (Tranche 3B B4/B5), which is why the test does not verify the peer.",
    "macOS shared tests run with CRT_CXX_RUNTIME_LINKAGE=shared (test-level env): the executable links libc.dylib, the libc every dylib of the port loads, instead of a second static libc.a (Mach-O two-level namespace: two malloc/pthread registries in one process).",
    "macOS: IPv6 stays enabled and libcurl carries no Apple framework: upstream's configure (CURL_DARWIN_SYSTEMCONFIGURATION, run when ipv6 and the host triple is Apple) links CoreFoundation, CoreServices and SystemConfiguration whenever a program that includes <TargetConditionals.h> compiles with TARGET_OS_MAC, and the CRT SDK's TargetConditionals.h says yes. target_overrides.macos.include_dirs puts porting/shims/macos/curl-no-apple-frameworks first; its header is an #error, so that single probe fails closed. Name resolution and sockets are CRT libc's (AF_INET6 and sockaddr_in6 in Bionic numbering, translated to Darwin inside libc; names through the host resolver, translated back)."
  ]
}
