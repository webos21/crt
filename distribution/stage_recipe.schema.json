{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webos21/crt/blob/main/distribution/stage_recipe.schema.json",
  "title": "CRT source-stage recipe",
  "type": "object",
  "required": ["schema_version", "input_stage", "output_stage", "target", "source", "build"],
  "properties": {
    "schema_version": {"const": 2},
    "input_stage": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
    "output_stage": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
    "target": {
      "type": "object",
      "required": ["os"],
      "properties": {
        "os": {"enum": ["linux", "macos", "windows"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["url", "archive", "size", "sha256", "source_commit"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "archive": {"type": "string", "pattern": "^[^/\\\\]+\\.tar\\.xz$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": {"type": "string", "pattern": "^[^/].*\\.py$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
